{
  "openapi": "3.1.0",
  "info": {
    "title": "Needs Platform Backend API",
    "version": "1.0.0",
    "description": "Production Modular Monolith API for Needs Service-Booking Platform built with Next.js App Router, PostgreSQL, PostGIS, Redis, BullMQ and Socket.IO."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT Access Token (issued by /api/v1/auth/otp/verify)"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "meta": {
            "type": "object"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  },
