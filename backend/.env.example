# ==============================================================================
# NEEDS BACKEND — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
SOCKET_PORT=4001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL + PostGIS Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/needs_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="needs_super_secret_jwt_access_key_min_32_characters_long_2026"
JWT_REFRESH_SECRET="needs_super_secret_jwt_refresh_key_min_32_characters_long_2026"
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_RESEND_PER_HOUR=3
OTP_MAX_ATTEMPTS=5

# Payment Gateways (bKash, Nagad, SSLCommerz)
BKASH_APP_KEY="bkash_sandbox_app_key"
BKASH_APP_SECRET="bkash_sandbox_app_secret"
BKASH_USERNAME="bkash_sandbox_username"
BKASH_PASSWORD="bkash_sandbox_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v2.0"

NAGAD_BASE_URL="https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
NAGAD_MERCHANT_ID="NAGAD_SANDBOX_MERCHANT"
NAGAD_PUBLIC_KEY="MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA..."
NAGAD_PRIVATE_KEY="MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC..."

SSLCOMMERZ_STORE_ID="needs_sandbox_store"
SSLCOMMERZ_STORE_PASSWORD="needs_sandbox_password"
SSLCOMMERZ_IS_SANDBOX=true

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID="needs-platform"
FCM_CLIENT_EMAIL="firebase-adminsdk@needs-platform.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# SMS Gateway (SSLWireless / BulkSMS)
SMS_GATEWAY_URL="https://smsplus.sslwireless.com/api/v3/send-sms"
SMS_GATEWAY_API_KEY="sslwireless_sandbox_api_key"
SMS_GATEWAY_SID="NEEDS_PLATFORM"

# S3 / Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="needs-storage"
S3_ACCESS_KEY="minio_access_key"
S3_SECRET_KEY="minio_secret_key"
S3_REGION="us-east-1"
